{
  "name": "conf-calendar",
  "productName": "학회 캘린더",
  "version": "1.5.0",
  "description": "시스템 · AI 학회 마감일과 개최일, 내 일정을 한눈에 보는 데스크톱 캘린더",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/parse.test.js && node test/gsync.test.js",
    "icon": "electron scripts/make-icon.js",
    "pack": "electron-builder --win nsis --publish never",
    "release": "node scripts/release.js"
  },
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.11",
    "js-yaml": "^5.5.0"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "local.conf-calendar",
    "productName": "학회 캘린더",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "data/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "학회 캘린더",
      "artifactName": "ConfCalendar-Setup.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ha-seungwon",
        "repo": "conf-calendar"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "ConfCalendar-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "ConfCalendar-${arch}.${ext}",
      "title": "학회 캘린더"
    }
  }
}
